{
  "servicio": "itsm-cambios",
  "base_de_datos": "DynamoDB (NoSQL, PAY_PER_REQUEST, DeletionPolicy Retain)",
  "tabla": "itsm-cambios-{stage}-cambios",
  "claves": {
    "partition": "tenant_id",
    "sort": "cambio_id"
  },
  "indices": [
    {
      "nombre": "GSI1",
      "partition": "tenant_id",
      "sort": "estado_creado",
      "formato_sort": "{estado}#{creado_en}",
      "proposito": "Listar cambios por estado (filtro ?estado=) sin Scan, más recientes primero."
    },
    {
      "nombre": "GSI2",
      "partition": "tenant_id",
      "sort": "ventana_inicio",
      "proposito": "Calendario de cambios (GET /cambios/calendario?desde&hasta). Índice disperso: solo contiene cambios PROGRAMADO o IMPLEMENTADO, que son los que tienen ventana."
    }
  ],
  "multi_tenancy": "tenant_id es la partition key y siempre se toma del contexto del Lambda Authorizer (JWT). Todas las consultas usan Query con tenant_id = tenant autenticado; un ID de otro tenant responde 404.",
  "estados": ["BORRADOR", "PENDIENTE_APROBACION", "APROBADO", "RECHAZADO", "PROGRAMADO", "IMPLEMENTADO"],
  "transiciones": {
    "POST /cambios/{id}/enviar": "BORRADOR -> PENDIENTE_APROBACION (requiere plan_implementacion y plan_rollback)",
    "POST /cambios/{id}/aprobar": "PENDIENTE_APROBACION -> APROBADO (solo ADMIN)",
    "POST /cambios/{id}/rechazar": "PENDIENTE_APROBACION -> RECHAZADO (solo ADMIN, requiere motivo)",
    "POST /cambios/{id}/programar": "APROBADO | PROGRAMADO -> PROGRAMADO (ventana_inicio < ventana_fin)",
    "POST /cambios/{id}/implementar": "PROGRAMADO -> IMPLEMENTADO"
  },
  "tipos": ["ESTANDAR", "NORMAL", "EMERGENCIA"],
  "riesgos": ["ALTO", "MEDIO", "BAJO"],
  "referencias_a_otros_servicios": {
    "solicitante_id": "usr-{tenant}-NNNNN (itsm-auth)",
    "aprobador_id": "usr-{tenant}-NNNNN (itsm-auth)",
    "problema_id": "prb-{tenant}-NNNNNN (itsm-problemas) o null",
    "solicitud_id": "req-{tenant}-NNNNNN (itsm-solicitudes) o null"
  },
